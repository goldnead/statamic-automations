{
    "name": "goldnead/statamic-automations",
    "description": "A visual automation layer built specifically for Statamic websites. Build automations for Statamic forms, entries, leads and webhooks with a familiar visual flow builder inside the Control Panel.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "automation",
        "workflow",
        "forms",
        "webhooks",
        "leads",
        "no-code"
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-automations/issues",
        "source": "https://github.com/goldnead/statamic-automations"
    },
    "authors": [
        {
            "name": "goldnead"
        }
    ],
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.0 || ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\StatamicAutomations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\StatamicAutomations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Automations",
            "description": "Visual automation builder for Statamic forms, entries, leads and webhooks."
        },
        "laravel": {
            "providers": [
                "Goldnead\\StatamicAutomations\\ServiceProvider"
            ],
            "aliases": {
                "Automations": "Goldnead\\StatamicAutomations\\Facades\\Automations"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "php-http/discovery": true,
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
