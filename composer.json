{
    "name": "goldnead/statamic-automations",
    "description": "A visual automation layer built specifically for Statamic websites. Build automations for Statamic forms, entries, leads and webhooks with a familiar visual flow builder inside the Control Panel.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": [
        "statamic",
        "statamic-addon",
        "automation",
        "workflow",
        "forms",
        "webhooks",
        "leads",
        "no-code"
    ],
    "authors": [
        {
            "name": "goldnead",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-automations/issues",
        "source": "https://github.com/goldnead/statamic-automations"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "statamic/cms": "^6.0",
        "inertiajs/inertia-laravel": "^1.0|^2.0",
        "goldnead/statamic-brand-context": "^1.8",
        "goldnead/statamic-flow-canvas": "^1.0.1"
    },
    "suggest": {
        "goldnead/statamic-leadhub": "Trigger automations from LeadHub CRM events (contacts, follow-ups, opportunities)",
        "goldnead/statamic-webhook-manager": "Delegate webhook delivery (retries, auth, logging) to Webhook Manager"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\StatamicAutomations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\StatamicAutomations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "slug": "statamic-automations",
            "name": "Statamic Automations",
            "url": "https://github.com/goldnead/statamic-automations",
            "description": "Visual automation builder for Statamic forms, entries, leads and webhooks.",
            "developer": "Adrian Goldner",
            "developer-url": "https://gldnr.studio",
            "vite": {
                "input": [
                    "resources/js/cp.js",
                    "resources/css/cp.css"
                ],
                "publicDirectory": "resources/dist"
            }
        },
        "laravel": {
            "providers": [
                "Goldnead\\StatamicAutomations\\ServiceProvider"
            ],
            "aliases": {
                "Automations": "Goldnead\\StatamicAutomations\\Facades\\Automations"
            }
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
