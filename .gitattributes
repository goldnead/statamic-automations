/.github          export-ignore
/tests            export-ignore
/scripts          export-ignore
/docs             export-ignore
/screenshots      export-ignore
/art              export-ignore
/.devcontainer    export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/.editorconfig    export-ignore
/phpunit.xml      export-ignore
/phpunit.mysql.xml export-ignore
/MARKETPLACE.md   export-ignore

# Development tooling config. Useful in the repo, noise in a customer's
# vendor/ directory.
/pint.json             export-ignore
/phpstan.neon          export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json       export-ignore

# Internal planning artifacts. These were shipping to customers: .superpowers/
# holds SDD briefs and progress notes, DESIGN-PLAN-editor-overhaul.md is an
# internal design document. Neither belongs in a paid install.
/.superpowers                    export-ignore
/DESIGN-PLAN-editor-overhaul.md  export-ignore

# The compiled Control Panel assets ship with the package under
# resources/dist/ — Statamic publishes them to the host's public/ on install.
# Keep the build sources (resources/{js,css}/, vite.config.js, package.json)
# shipped too so the addon can be rebuilt from source; only exclude the
# installed node_modules / vendor / scaffolded playground from the dist tarball.
/node_modules     export-ignore
/vendor           export-ignore
/playground       export-ignore
